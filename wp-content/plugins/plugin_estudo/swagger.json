  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Insira o token JWT gerado pelo endpoint /api/v1/login."
      }
    },
    "schemas": {
      "MensagemResposta": {
        "type": "object",
        "properties": {
          "message": { "type": "string", "example": "Operação executada com sucesso" }
        }
      },
      "SiteSettings": {
        "type": "object",
        "properties": {
          "title": { "type": "string", "example": "Meu Site WordPress" },
          "description": { "type": "string", "example": "Descrição personalizada do site" },
          "logo": { "type": "string", "example": "https://exemplo.com/logo.png" },
          "home_url": { "type": "string", "example": "https://exemplo.com/" }
        }
      },
      "Categoria": {
        "type": "object",
        "properties": {
          "term_id": { "type": "integer", "example": 1 },
          "name": { "type": "string", "example": "Notícias" },
          "slug": { "type": "string", "example": "noticias" },
          "term_group": { "type": "integer", "example": 0 }
        }
      },
      "Produto": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 10 },
          "title": { "type": "string", "example": "Produto Exemplo" },
          "price": { "type": "number", "example": 99.90 },
          "description": { "type": "string", "example": "Descrição do produto em detalhes." },
          "image": { "type": "string", "example": "https://exemplo.com/produto.jpg" }
        }
      },
      "Post": {
        "type": "object",
        "properties": {
          "ID": { "type": "integer", "example": 1 },
          "post_title": { "type": "string", "example": "Olá, mundo!" },
          "post_content": { "type": "string", "example": "Bem-vindo ao WordPress." },
          "post_date": { "type": "string", "example": "2026-01-01 10:00:00" }
        }
      },
      "Pagina": {
        "type": "object",
        "properties": {
          "ID": { "type": "integer", "example": 2 },
          "post_title": { "type": "string", "example": "Sobre Nós" },
          "post_content": { "type": "string", "example": "Página institucional da empresa." },
          "post_date": { "type": "string", "example": "2026-01-01 12:00:00" }
        }
      },
      "ResultadoCalculo": {
        "type": "object",
        "properties": {
          "resultado": {
            "type": "number",
            "description": "Resultado numérico da operação matemática",
            "example": 77
          }
        }
      },
      "Marca": {
        "type": "object",
        "description": "Registro de Marca",
        "properties": {
          "id": {
            "type": "integer",
            "description": "ID único da marca (chave primária)",
            "example": 1
          },
          "nome": {
            "type": "string",
            "description": "Nome da marca",
            "example": "Nike"
          }
        }
      },
      "MarcaEntrada": {
        "type": "object",
        "description": "Payload de entrada para criação ou atualização de marca",
        "required": ["nome"],
        "properties": {
          "nome": {
            "type": "string",
            "description": "Nome da marca",
            "example": "Nike"
          }
        }
      },
      "Modelo": {
        "type": "object",
        "description": "Registro de Modelo",
        "properties": {
          "id": {
            "type": "integer",
            "description": "ID único do modelo",
            "example": 1
          },
          "id_marca": {
            "type": "integer",
            "description": "ID da marca relacionada",
            "example": 1
          },
          "nome": {
            "type": "string",
            "description": "Nome do modelo",
            "example": "Corolla"
          }
        }
      },
      "ModeloEntrada": {
        "type": "object",
        "description": "Payload de entrada para criação ou atualização de modelo",
        "required": ["id_marca", "nome"],
        "properties": {
          "id_marca": {
            "type": "integer",
            "description": "ID da marca relacionada",
            "example": 1
          },
          "nome": {
            "type": "string",
            "description": "Nome do modelo",
            "example": "Corolla"
          }
        }
      }
    }
  }
}
