{
  "openapi": "3.0.3",
  "info": {
    "title": "WordPress REST API - Plugin Estudo",
    "description": "Documentação completa OpenAPI 3.0 / Swagger de todos os controladores da WordPress REST API (api/v1) do plugin plugin_estudo. Inclui autenticação JWT, configurações, categorias, produtos, posts, páginas e calculadora.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://luizbrogliatto.freedev.app/wp-json",
      "description": "Servidor de Desenvolvimento / Produção"
    }
  ],
  "tags": [
    {
      "name": "Autenticação",
      "description": "Endpoints para login, renovação de token JWT, validação e recuperação de senha."
    },
    {
      "name": "Configurações",
      "description": "Configurações gerais do site, logos e metadados."
    },
    {
      "name": "Categorias",
      "description": "Consulta e gerenciamento de categorias da API."
    },
    {
      "name": "Produtos",
      "description": "Catálogo e detalhes de produtos."
    },
    {
      "name": "Posts",
      "description": "Consulta de artigos e publicações do blog."
    },
    {
      "name": "Páginas",
      "description": "Consulta de páginas institucionais do WordPress."
    },
    {
      "name": "Calculadora",
      "description": "Operações matemáticas demonstrativas da API."
    },
    {
      "name": "Marcas",
      "description": "CRUD completo de Marcas (campos id e nome)."
    },
    {
      "name": "Modelos",
      "description": "CRUD completo de Modelos (campos id, id_marca e nome)."
    }
  ],
  "paths": {
    "/api/v1/login": {
      "post": {
        "tags": ["Autenticação"],
        "summary": "Realizar login e obter Token JWT",
        "description": "Autentica o usuário no WordPress e retorna um Token JWT assinado com HS512.",
        "operationId": "loginUsuario",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "password"],
                "properties": {
                  "username": { "type": "string", "example": "admin" },
                  "password": { "type": "string", "format": "password", "example": "123456" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Autenticação realizada com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "jwt": { "type": "string", "example": "eyJhbGciOiJIUzUxMiIsInR5cCI6IkpXVCJ9..." }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Credenciais inválidas",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MensagemResposta" },
                "example": { "message": "username or password inválid" }
              }
            }
          }
        }
      }
    },
    "/api/v1/logout": {
      "post": {
        "tags": ["Autenticação"],
        "summary": "Encerrar sessão (Logout)",
        "description": "Finaliza a sessão associada ao token JWT enviado no cabeçalho Authorization.",
        "operationId": "logoutUsuario",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Logout realizado com sucesso",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MensagemResposta" },
                "example": { "message": "Logout successful!" }
              }
            }
          },
          "400": {
            "description": "Falha ao realizar logout",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MensagemResposta" }
              }
            }
          }
        }
      }
    },
    "/api/v1/new_token": {
      "post": {
        "tags": ["Autenticação"],
        "summary": "Renovar Token JWT",
        "description": "Gera um novo token JWT a partir do token atualmente válido enviado no cabeçalho.",
        "operationId": "renovarToken",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Novo token gerado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "jwt": { "type": "string", "example": "eyJhbGciOiJIUzUxMiIsInR5cCI6IkpXVCJ9..." }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/verify": {
      "post": {
        "tags": ["Autenticação"],
        "summary": "Validar validade e expiração do Token JWT",
        "description": "Verifica se o token JWT presente no cabeçalho Authorization ainda é válido e ativo.",
        "operationId": "verificarToken",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Status de validação do token",
            "content": {
              "application/json": {
                "schema": { "type": "boolean", "example": true }
              }
            }
          }
        }
      }
    },
    "/api/v1/forgot": {
      "post": {
        "tags": ["Autenticação"],
        "summary": "Solicitar redefinição de senha por e-mail",
        "description": "Envia um e-mail com link e token para redefinição de senha do usuário.",
        "operationId": "esqueciSenha",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email"],
                "properties": {
                  "email": { "type": "string", "format": "email", "example": "usuario@exemplo.com" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "E-mail de redefinição enviado com sucesso",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MensagemResposta" },
                "example": { "message": "success send e-mail" }
              }
            }
          },
          "400": {
            "description": "E-mail inválido ou usuário não encontrado",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MensagemResposta" },
                "example": { "message": "verify your e-mail" }
              }
            }
          }
        }
      }
    },
    "/api/v1/code": {
      "post": {
        "tags": ["Autenticação"],
        "summary": "Validar código de recuperação de senha",
        "description": "Verifica se a chave recebida no e-mail para redefinição de senha ainda é válida.",
        "operationId": "validarCodigoRecuperacao",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["login", "code"],
                "properties": {
                  "login": { "type": "string", "example": "admin" },
                  "code": { "type": "string", "example": "a1b2c3d4e5" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Código válido",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MensagemResposta" },
                "example": { "message": "code valid" }
              }
            }
          },
          "400": {
            "description": "Código expirado ou inválido",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MensagemResposta" },
                "example": { "message": "code inválid or exprired" }
              }
            }
          }
        }
      }
    },
    "/api/v1/newPassword": {
      "post": {
        "tags": ["Autenticação"],
        "summary": "Definir nova senha",
        "description": "Altera a senha do usuário utilizando a chave de redefinição previamente validada.",
        "operationId": "redefinirNovaSenha",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["login", "code", "new_password"],
                "properties": {
                  "login": { "type": "string", "example": "admin" },
                  "code": { "type": "string", "example": "a1b2c3d4e5" },
                  "new_password": { "type": "string", "format": "password", "example": "novaSenhaSegura#123" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Senha alterada com sucesso",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MensagemResposta" },
                "example": { "message": "Password reset successful" }
              }
            }
          },
          "400": {
            "description": "Erro na redefinição da senha",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MensagemResposta" }
              }
            }
          }
        }
      }
    },
    "/api/v1/settings": {
      "get": {
        "tags": ["Configurações"],
        "summary": "Obter configurações gerais do site",
        "description": "Retorna metadados como título, descrição, URL da logo e URL principal do WordPress.",
        "operationId": "obterConfiguracoes",
        "responses": {
          "200": {
            "description": "Configurações do site obtidas com sucesso",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SiteSettings" },
                "example": {
                  "title": "Meu Site WordPress",
                  "description": "Apenas mais um site WordPress",
                  "logo": "https://luizbrogliatto.freedev.app/wp-content/uploads/logo.png",
                  "home_url": "https://luizbrogliatto.freedev.app/"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/categories": {
      "get": {
        "tags": ["Categorias"],
        "summary": "Listar categorias cadastradas",
        "description": "Retorna a lista paginada de categorias do WordPress.",
        "operationId": "listarCategorias",
        "parameters": [
          { "name": "page", "in": "query", "description": "Número da página", "schema": { "type": "integer", "default": 1 }, "example": 1 },
          { "name": "per_page", "in": "query", "description": "Itens por página", "schema": { "type": "integer", "default": 100 }, "example": 20 },
          { "name": "all", "in": "query", "description": "Retornar todas sem paginação", "schema": { "type": "boolean" }, "example": false }
        ],
        "responses": {
          "200": {
            "description": "Lista de categorias obtida com sucesso",
            "headers": {
              "x-wp-total": { "description": "Total de categorias", "schema": { "type": "integer" } },
              "x-wp-totalpages": { "description": "Total de páginas", "schema": { "type": "integer" } }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Categoria" }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/categories/{id}": {
      "get": {
        "tags": ["Categorias"],
        "summary": "Obter categoria por ID",
        "description": "Retorna os dados completos de uma categoria específica.",
        "operationId": "obterCategoriaPorId",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "description": "ID único da categoria", "schema": { "type": "integer" }, "example": 1 }
        ],
        "responses": {
          "200": {
            "description": "Dados da categoria retornados com sucesso",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Categoria" }
              }
            }
          },
          "404": {
            "description": "Categoria não encontrada",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MensagemResposta" },
                "example": { "message": "not found" }
              }
            }
          }
        }
      }
    },
    "/api/v1/products": {
      "get": {
        "tags": ["Produtos"],
        "summary": "Listar produtos da loja",
        "description": "Retorna a lista paginada de produtos cadastrados.",
        "operationId": "listarProdutos",
        "parameters": [
          { "name": "page", "in": "query", "description": "Número da página", "schema": { "type": "integer", "default": 1 }, "example": 1 },
          { "name": "per_page", "in": "query", "description": "Produtos por página", "schema": { "type": "integer", "default": 12 }, "example": 12 }
        ],
        "responses": {
          "200": {
            "description": "Lista de produtos retornada com sucesso",
            "headers": {
              "x-wp-total": { "description": "Total geral de produtos", "schema": { "type": "integer" } },
              "x-wp-totalpages": { "description": "Total de páginas", "schema": { "type": "integer" } }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Produto" }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/products/{id}": {
      "get": {
        "tags": ["Produtos"],
        "summary": "Obter produto por ID",
        "description": "Retorna as informações detalhadas de um produto específico.",
        "operationId": "obterProdutoPorId",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "description": "ID numérico do produto", "schema": { "type": "integer" }, "example": 10 }
        ],
        "responses": {
          "200": {
            "description": "Dados do produto obtidos com sucesso",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Produto" }
              }
            }
          },
          "404": {
            "description": "Produto não encontrado",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MensagemResposta" },
                "example": { "message": "not found" }
              }
            }
          }
        }
      }
    },
    "/api/v1/posts": {
      "get": {
        "tags": ["Posts"],
        "summary": "Listar publicações do blog",
        "description": "Retorna a lista paginada de posts do WordPress.",
        "operationId": "listarPosts",
        "parameters": [
          { "name": "page", "in": "query", "description": "Número da página", "schema": { "type": "integer", "default": 1 }, "example": 1 },
          { "name": "per_page", "in": "query", "description": "Posts por página", "schema": { "type": "integer", "default": 12 }, "example": 10 }
        ],
        "responses": {
          "200": {
            "description": "Lista de posts obtida com sucesso",
            "headers": {
              "x-wp-total": { "description": "Total de posts", "schema": { "type": "integer" } },
              "x-wp-totalpages": { "description": "Total de páginas", "schema": { "type": "integer" } }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Post" }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/posts/{id}": {
      "get": {
        "tags": ["Posts"],
        "summary": "Obter post por ID",
        "description": "Retorna o conteúdo e metadados de uma publicação específica.",
        "operationId": "obterPostPorId",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "description": "ID da publicação", "schema": { "type": "integer" }, "example": 1 }
        ],
        "responses": {
          "200": {
            "description": "Dados do post encontrados com sucesso",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Post" }
              }
            }
          },
          "404": {
            "description": "Post não encontrado",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MensagemResposta" },
                "example": { "message": "not found" }
              }
            }
          }
        }
      }
    },
    "/api/v1/pages": {
      "get": {
        "tags": ["Páginas"],
        "summary": "Listar páginas do site",
        "description": "Retorna a lista paginada de páginas cadastradas no WordPress.",
        "operationId": "listarPaginas",
        "parameters": [
          { "name": "page", "in": "query", "description": "Número da página", "schema": { "type": "integer", "default": 1 }, "example": 1 },
          { "name": "per_page", "in": "query", "description": "Páginas por página", "schema": { "type": "integer", "default": 12 }, "example": 10 }
        ],
        "responses": {
          "200": {
            "description": "Lista de páginas obtida com sucesso",
            "headers": {
              "x-wp-total": { "description": "Total de páginas", "schema": { "type": "integer" } },
              "x-wp-totalpages": { "description": "Total de páginas", "schema": { "type": "integer" } }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Pagina" }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/pages/{id}": {
      "get": {
        "tags": ["Páginas"],
        "summary": "Obter página por ID",
        "description": "Retorna os dados completos e conteúdo de uma página específica.",
        "operationId": "obterPaginaPorId",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "description": "ID da página", "schema": { "type": "integer" }, "example": 2 }
        ],
        "responses": {
          "200": {
            "description": "Dados da página encontrados com sucesso",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Pagina" }
              }
            }
          },
          "404": {
            "description": "Página não encontrada",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MensagemResposta" },
                "example": { "message": "not found" }
              }
            }
          }
        }
      }
    },
    "/api/v1/calculadora/soma/{v1}/{v2}": {
      "get": {
        "tags": ["Calculadora"],
        "summary": "Realizar soma de dois números",
        "description": "Retorna a soma entre v1 e v2.",
        "operationId": "somarValores",
        "parameters": [
          { "name": "v1", "in": "path", "required": true, "schema": { "type": "integer" }, "example": 70 },
          { "name": "v2", "in": "path", "required": true, "schema": { "type": "integer" }, "example": 7 }
        ],
        "responses": {
          "200": {
            "description": "Operação de soma concluída",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ResultadoCalculo" },
                "example": { "resultado": 77 }
              }
            }
          }
        }
      }
    },
    "/api/v1/calculadora/subtracao/{v1}/{v2}": {
      "post": {
        "tags": ["Calculadora"],
        "summary": "Realizar subtração de dois números",
        "description": "Retorna o resultado da subtração de v1 por v2.",
        "operationId": "subtrairValores",
        "parameters": [
          { "name": "v1", "in": "path", "required": true, "schema": { "type": "integer" }, "example": 70 },
          { "name": "v2", "in": "path", "required": true, "schema": { "type": "integer" }, "example": 7 }
        ],
        "responses": {
          "200": {
            "description": "Operação de subtração concluída",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ResultadoCalculo" },
                "example": { "resultado": 63 }
              }
            }
          }
        }
      }
    },
    "/api/v1/calculadora/multiplicacao/{v1}/{v2}": {
      "put": {
        "tags": ["Calculadora"],
        "summary": "Realizar multiplicação de dois números",
        "description": "Retorna a multiplicação entre v1 e v2 (método EDITABLE).",
        "operationId": "multiplicarValores",
        "parameters": [
          { "name": "v1", "in": "path", "required": true, "schema": { "type": "integer" }, "example": 70 },
          { "name": "v2", "in": "path", "required": true, "schema": { "type": "integer" }, "example": 7 }
        ],
        "responses": {
          "200": {
            "description": "Operação de multiplicação concluída",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ResultadoCalculo" },
                "example": { "resultado": 490 }
              }
            }
          }
        }
      }
    },
    "/api/v1/calculadora/divisao/{v1}/{v2}": {
      "delete": {
        "tags": ["Calculadora"],
        "summary": "Realizar divisão de dois números",
        "description": "Retorna o quociente da divisão de v1 por v2 (método DELETABLE).",
        "operationId": "dividirValores",
        "parameters": [
          { "name": "v1", "in": "path", "required": true, "schema": { "type": "integer" }, "example": 70 },
          { "name": "v2", "in": "path", "required": true, "schema": { "type": "integer" }, "example": 7 }
        ],
        "responses": {
          "200": {
            "description": "Operação de divisão concluída",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ResultadoCalculo" },
                "example": { "resultado": 10 }
              }
            }
          }
        }
      }
    },
    "/api/v1/calculadora/fibonacci/{n}": {
      "get": {
        "tags": ["Calculadora"],
        "summary": "Calcular Fibonacci via PATH",
        "description": "Retorna o n-ésimo número de Fibonacci e a sequência até a posição informada via path.",
        "operationId": "calcularFibonacci",
        "parameters": [
          { "name": "n", "in": "path", "required": true, "description": "Posição na sequência de Fibonacci", "schema": { "type": "integer" }, "example": 7 }
        ],
        "responses": {
          "200": {
            "description": "Sequência e número calculados com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "posicao": { "type": "integer", "example": 7 },
                    "resultado": { "type": "integer", "example": 13 },
                    "sequencia": {
                      "type": "array",
                      "items": { "type": "integer" },
                      "example": [0, 1, 1, 2, 3, 5, 8, 13]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/calculadora/potencia": {
      "post": {
        "tags": ["Calculadora"],
        "summary": "Calcular Potência via BODY RAW POST",
        "description": "Calcula a potência de v1 (base) elevado a v2 (expoente) enviado via JSON no corpo da requisição.",
        "operationId": "calcularPotencia",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["v1", "v2"],
                "properties": {
                  "v1": { "type": "number", "description": "Base da potência", "example": 2 },
                  "v2": { "type": "number", "description": "Expoente da potência", "example": 8 }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cálculo de potência realizado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "base": { "type": "number", "example": 2 },
                    "expoente": { "type": "number", "example": 8 },
                    "resultado": { "type": "number", "example": 256 }
                  }
                }
              }
            }
          }
        }
      }
    },
