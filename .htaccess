# ============================================================
# WordPress + REST API + CORS
# ============================================================

<IfModule mod_rewrite.c>

    RewriteEngine On
    RewriteBase /

    # --------------------------------------------------------
    # Não reescrever o index.php
    # --------------------------------------------------------
    RewriteRule ^index\.php$ - [L]

    # --------------------------------------------------------
    # WordPress REST API
    # Converte:
    #
    # /wp-json/
    # /wp-json/wp/v2/posts
    # /wp-json/api/v1/categories
    #
    # para o parâmetro interno:
    #
    # rest_route=/...
    # --------------------------------------------------------

    RewriteRule ^wp-json/?$ index.php?rest_route=/ [QSA,L]

    RewriteRule ^wp-json/(.*)$ index.php?rest_route=/$1 [QSA,L]

    # --------------------------------------------------------
    # Arquivos e diretórios existentes
    # --------------------------------------------------------

    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # --------------------------------------------------------
    # Demais URLs do WordPress
    # --------------------------------------------------------

    RewriteRule . /index.php [L]

</IfModule>


# ============================================================
# CORS
# ============================================================

<IfModule mod_headers.c>

    Header always set Access-Control-Allow-Origin "*"

    Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"

    Header always set Access-Control-Allow-Headers "Authorization, Content-Type, X-Requested-With"

    Header always set Access-Control-Expose-Headers "Authorization, Content-Type"

</IfModule>


# ============================================================
# CORS PREFLIGHT
# ============================================================

<IfModule mod_rewrite.c>

    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteRule ^ - [R=204,L]

</IfModule>


# ============================================================
# SEGURANÇA
# ============================================================

<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# ============================================================
# FIM
# ============================================================
